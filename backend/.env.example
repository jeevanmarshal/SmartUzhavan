# SmartUzhavan Backend - Environment Variables Example File
# Copy this file to '.env' or '.env.development' and fill in the values.

# Server Execution Mode (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartuzhavan

# Session & JWT Secrets (Must be secure, long strings)
SESSION_SECRET=your_32_character_session_secret_key_here
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRY=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Email Notifications (SMTP configuration for admin alerts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
ADMIN_EMAIL=admin@smartuzhavan.com
